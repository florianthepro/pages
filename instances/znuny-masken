function createStorage():void{
if(is_file(DATA_FILE)){return;}
$json=json_encode(defaultData(),JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);
if($json===false||file_put_contents(DATA_FILE,$json,LOCK_EX)===false){
http_response_code(500);
exit('masks.json konnte nicht erstellt werden. Der Ordner muss für PHP beschreibbar sein.');
}
@chmod(DATA_FILE,0660);
}
function loadData():array{
createStorage();
$handle=@fopen(DATA_FILE,'rb');
if($handle===false){http_response_code(500);exit('masks.json kann nicht gelesen werden.');}
if(!flock($handle,LOCK_SH)){fclose($handle);http_response_code(500);exit('masks.json kann nicht gesperrt werden.');}
$json=stream_get_contents($handle);
flock($handle,LOCK_UN);
fclose($handle);
$data=json_decode((string)$json,true);
if(json_last_error()!==JSON_ERROR_NONE||!is_array($data)){
http_response_code(500);
exit('masks.json enthält ungültiges JSON: '.e(json_last_error_msg()));
}
if(!isset($data['settings'])||!is_array($data['settings'])){$data['settings']=[];}
foreach(['ticketTypes','queues','services','states'] as $key){
if(!isset($data['settings'][$key])||!is_array($data['settings'][$key])){$data['settings'][$key]=[];}
}
if(!isset($data['masks'])||!is_array($data['masks'])){$data['masks']=[];}
return $data;
}
function saveData(array $data):void{
$json=json_encode($data,JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);
if($json===false){throw new RuntimeException('Die Daten konnten nicht als JSON verarbeitet werden.');}
$temp=DATA_FILE.'.tmp';
$handle=@fopen($temp,'c+b');
if($handle===false){throw new RuntimeException('Die temporäre JSON-Datei ist nicht beschreibbar.');}
if(!flock($handle,LOCK_EX)){fclose($handle);throw new RuntimeException('Die JSON-Datei konnte nicht gesperrt werden.');}
$success=ftruncate($handle,0)&&rewind($handle);
$written=$success?fwrite($handle,$json):false;
$success=$success&&$written!==false&&$written===strlen($json)&&fflush($handle);
flock($handle,LOCK_UN);
fclose($handle);
if(!$success){@unlink($temp);throw new RuntimeException('masks.json konnte nicht vollständig geschrieben werden.');}
@chmod($temp,0660);
if(!@rename($temp,DATA_FILE)){@unlink($temp);throw new RuntimeException('masks.json konnte nicht ersetzt werden.');}
}
function token():string{
if(empty($_SESSION['csrf'])||!is_string($_SESSION['csrf'])){
try{$_SESSION['csrf']=bin2hex(random_bytes(32));}catch(Throwable $error){$_SESSION['csrf']=hash('sha256',uniqid('',true));}
}
return $_SESSION['csrf'];
}
function verifyToken():void{
$value=isset($_POST['csrf'])&&is_string($_POST['csrf'])?$_POST['csrf']:'';
if(!hash_equals(token(),$value)){http_response_code(403);exit('Ungültige Anfrage.');}
}
function listValues($value):array{
if(!is_string($value)){return [];}
$items=preg_split('/\R/u',$value);
$result=[];
foreach(is_array($items)?$items:[] as $item){
$item=cut($item,120);
if($item!==''&&!in_array($item,$result,true)){$result[]=$item;}
}
return $result;
}
function postArray(string $name):array{
return isset($_POST[$name])&&is_array($_POST[$name])?$_POST[$name]:[];
}
function findMask(array $data,string $id):?array{
foreach($data['masks'] as $mask){
if(is_array($mask)&&(string)($mask['id']??'')===$id){return $mask;}
}
return null;
}
function maskFromPost():array{
$name=cut($_POST['name']??'',120);
if($name===''){throw new RuntimeException('Der Maskenname fehlt.');}
$ids=postArray('step_id');
$names=postArray('step_name');
$actions=postArray('step_action');
$types=postArray('step_type');
$queues=postArray('step_queue');
$services=postArray('step_service');
$states=postArray('step_state');
$subjects=postArray('step_subject');
$bodies=postArray('step_body');
if(count($actions)<1){throw new RuntimeException('Mindestens ein Schritt ist erforderlich.');}
if(count($actions)>100){throw new RuntimeException('Maximal 100 Schritte sind erlaubt.');}
$steps=[];
foreach($actions as $index=>$rawAction){
$action=cut($rawAction,20);
if(!in_array($action,['ticket','note'],true)){$action='note';}
$stepName=cut($names[$index]??'',120);
if($stepName===''){throw new RuntimeException('Jeder Schritt benötigt eine Bezeichnung.');}
$stepId=cut($ids[$index]??'',64);
$steps[]=[
'id'=>$stepId!==''?$stepId:newId(),
'action'=>$action,
'name'=>$stepName,
'type'=>cut($types[$index]??'',120),
'queue'=>cut($queues[$index]??'',120),
'service'=>cut($services[$index]??'',120),
'state'=>cut($states[$index]??'',120),
'subject'=>cut($subjects[$index]??'',500),
'body'=>cut($bodies[$index]??'',20000)
];
}
$id=cut($_POST['mask_id']??'',64);
return [
'id'=>$id!==''?$id:newId(),
'name'=>$name,
'description'=>cut($_POST['description']??'',2000),
'published'=>isset($_POST['published']),
'steps'=>$steps,
'updatedAt'=>gmdate('c')
];
}
function placeholders(array $mask):array{
$result=[];
foreach($mask['steps']??[] as $step){
if(!is_array($step)){continue;}
foreach(['subject','body'] as $field){
preg_match_all('/\{\{([^{}]{1,80})\}\}/u',(string)($step[$field]??''),$matches);
foreach($matches[1]??[] as $name){
$name=trim((string)$name);
if($name!==''&&!in_array($name,$result,true)){$result[]=$name;}
}
}
}
return $result;
}
if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'&&(int)($_SERVER['CONTENT_LENGTH']??0)>MAX_POST_SIZE){
http_response_code(413);
exit('Die Anfrage ist zu groß.');
}
$data=loadData();
