<script>
(function(){
"use strict";

document.addEventListener("click",function(event){
var locationButton=event.target.closest("[data-location]");
if(locationButton){
window.location.href=locationButton.getAttribute("data-location");
return;
}

if(event.target.id==="menuButton"){
var overlay=document.getElementById("menuOverlay");
overlay.classList.add("visible");
overlay.setAttribute("aria-hidden","false");
return;
}

if(event.target.id==="menuClose"||event.target.id==="menuBackdrop"){
var menu=document.getElementById("menuOverlay");
menu.classList.remove("visible");
menu.setAttribute("aria-hidden","true");
return;
}

var removeButton=event.target.closest("[data-remove]");
if(removeButton){
var item=removeButton.closest(".editor-item");
var parent=item.parentElement;
if(parent.id==="steps"&&parent.querySelectorAll(".editor-item").length===1){
window.alert("Mindestens ein Prozessschritt ist erforderlich.");
return;
}
item.remove();
return;
}

var upButton=event.target.closest("[data-up]");
if(upButton){
var upItem=upButton.closest(".editor-item");
var previous=upItem.previousElementSibling;
if(previous){
upItem.parentElement.insertBefore(upItem,previous);
}
return;
}

var downButton=event.target.closest("[data-down]");
if(downButton){
var downItem=downButton.closest(".editor-item");
var next=downItem.nextElementSibling;
if(next){
downItem.parentElement.insertBefore(next,downItem);
}
return;
}
});

document.addEventListener("input",function(event){
if(event.target.matches("[data-field-label]")){
var fieldItem=event.target.closest(".editor-item");
fieldItem.querySelector("[data-field-title]").textContent=event.target.value||"Unbenanntes Feld";
}

if(event.target.matches("[data-step-name]")){
var stepItem=event.target.closest(".editor-item");
stepItem.querySelector("[data-step-title]").textContent=event.target.value||"Unbenannter Schritt";
}

if(event.target.matches("[data-operation-input]")){
var operationItem=event.target.closest(".editor-item");
operationItem.querySelector("[data-operation-title]").textContent=event.target.value;
}
});

var addField=document.getElementById("addField");
var fields=document.getElementById("fields");
var fieldTemplate=document.getElementById("fieldTemplate");

if(addField&&fields&&fieldTemplate){
addField.addEventListener("click",function(){
fields.appendChild(fieldTemplate.content.firstElementChild.cloneNode(true));
});
}

var addStep=document.getElementById("addStep");
var steps=document.getElementById("steps");
var stepTemplate=document.getElementById("stepTemplate");

if(addStep&&steps&&stepTemplate){
addStep.addEventListener("click",function(){
steps.appendChild(stepTemplate.content.firstElementChild.cloneNode(true));
});
}

var maskData=document.getElementById("maskData");
if(!maskData){
return;
}

var mask;
try{
mask=JSON.parse(maskData.textContent);
}catch(error){
return;
}

var workflow=document.getElementById("workflow");
var variableText=document.getElementById("variableText");
var names=[];
var values={};
var pattern=/\{\{([^{}]{1,80})\}\}/g;

function collect(source){
String(source||"").replace(pattern,function(match,name){
name=name.trim();
if(name!==""&&!Object.prototype.hasOwnProperty.call(values,name)){
names.push(name);
values[name]=name;
}
return match;
});
pattern.lastIndex=0;
}

(mask.fields||[]).forEach(function(field){
collect(field.value);
});

(mask.steps||[]).forEach(function(step){
collect(step.subject);
collect(step.body);
});

function serialize(){
return names.map(function(name){
return name+": "+values[name];
}).join("\n");
}

function parse(){
var lines=variableText.value.split(/\r?\n/);
var currentName=null;
var parsed={};

lines.forEach(function(line){
var colon=line.indexOf(":");
var candidate="";

if(colon>=0){
candidate=line.slice(0,colon).trim();
}

if(candidate!==""&&Object.prototype.hasOwnProperty.call(values,candidate)){
currentName=candidate;
parsed[currentName]=line.slice(colon+1).replace(/^\s/,"");
return;
}

if(currentName!==null){
parsed[currentName]+="\n"+line;
}
});

names.forEach(function(name){
if(Object.prototype.hasOwnProperty.call(parsed,name)){
if(parsed[name]===""){
values[name]=name;
}else{
values[name]=parsed[name];
}
}
});
}

function valueOf(name){
if(Object.prototype.hasOwnProperty.call(values,name)&&values[name]!==""){
return values[name];
}
return name;
}

function focusVariable(name){
var lines=variableText.value.split(/\r?\n/);
var offset=0;

for(var index=0;index<lines.length;index++){
var line=lines[index];
var colon=line.indexOf(":");

if(colon>=0&&line.slice(0,colon).trim()===name){
var start=offset+colon+1;
while(start<offset+line.length&&variableText.value.charAt(start)===" "){
start++;
}
variableText.focus();
variableText.setSelectionRange(start,offset+line.length);
break;
}

offset+=line.length+1;
}

document.querySelectorAll(".variable").forEach(function(button){
if(button.getAttribute("data-variable")===name){
button.classList.add("active");
}else{
button.classList.remove("active");
}
});
}

function renderTemplate(container,source){
container.textContent="";
var expression=/\{\{([^{}]{1,80})\}\}/g;
var position=0;
var match;

while((match=expression.exec(String(source||"")))!==null){
if(match.index>position){
container.appendChild(document.createTextNode(String(source).slice(position,match.index)));
}

var name=match[1].trim();
var button=document.createElement("button");
button.type="button";
button.className="variable";
button.setAttribute("data-variable",name);
button.textContent=valueOf(name);
button.addEventListener("click",(function(variableName){
return function(){
focusVariable(variableName);
};
})(name));

container.appendChild(button);
position=expression.lastIndex;
}

if(position<String(source||"").length){
container.appendChild(document.createTextNode(String(source).slice(position)));
}
}

function render(){
workflow.textContent="";

(mask.steps||[]).forEach(function(step,index){
if(index>0){
var arrow=document.createElement("div");
arrow.className="process-arrow";
arrow.textContent="↓";
workflow.appendChild(arrow);
}

var ticket=document.createElement("section");
ticket.className="ticket";

var header=document.createElement("div");
header.className="ticket-header";

var number=document.createElement("span");
number.className="ticket-number";
number.textContent=String(index+1);

var title=document.createElement("strong");
title.textContent=step.name||"Prozessschritt";

var operation=document.createElement("span");
operation.className="ticket-operation";
operation.textContent=step.operation||"";

header.appendChild(number);
header.appendChild(title);
header.appendChild(operation);
ticket.appendChild(header);

var ticketFields=document.createElement("div");
ticketFields.className="ticket-fields";

(mask.fields||[]).forEach(function(field){
if(!field.label){
return;
}

var label=document.createElement("div");
label.className="ticket-label";
label.textContent=field.label;

var value=document.createElement("div");
value.className="ticket-value";
renderTemplate(value,field.value);

ticketFields.appendChild(label);
ticketFields.appendChild(value);
});

if(ticketFields.childNodes.length>0){
ticket.appendChild(ticketFields);
}

var content=document.createElement("div");
content.className="ticket-content";

if(step.subject){
var subject=document.createElement("div");
subject.className="ticket-subject";
renderTemplate(subject,step.subject);
content.appendChild(subject);
}

var body=document.createElement("div");
body.className="ticket-text";
renderTemplate(body,step.body||"");
content.appendChild(body);

ticket.appendChild(content);
workflow.appendChild(ticket);
});
}

function plain(source){
return String(source||"").replace(/\{\{([^{}]{1,80})\}\}/g,function(match,name){
return valueOf(name.trim());
});
}

function processOutput(){
return (mask.steps||[]).map(function(step,index){
var lines=[
String(index+1)+". "+String(step.name||"Prozessschritt")
];

if(step.operation){
lines.push("Prozessart: "+step.operation);
}

(mask.fields||[]).forEach(function(field){
if(field.label){
lines.push(field.label+": "+plain(field.value));
}
});

if(step.subject){
lines.push("Betreff: "+plain(step.subject));
}

lines.push("");
lines.push(plain(step.body));

return lines.join("\n").trim();
}).join("\n\n========================================\n\n");
}

function copy(text,button){
function fallback(){
var area=document.createElement("textarea");
area.value=text;
area.style.position="fixed";
area.style.left="-9999px";
document.body.appendChild(area);
area.select();
document.execCommand("copy");
area.remove();
}

function done(){
var oldText=button.textContent;
button.textContent="Kopiert";
window.setTimeout(function(){
button.textContent=oldText;
},1000);
}

if(navigator.clipboard&&window.isSecureContext){
navigator.clipboard.writeText(text).then(done).catch(function(){
fallback();
done();
});
}else{
fallback();
done();
}
}

variableText.value=serialize();

variableText.addEventListener("input",function(){
parse();
render();
});

document.getElementById("applyVariables").addEventListener("click",function(){
parse();
variableText.value=serialize();
render();
});

document.getElementById("copyVariables").addEventListener("click",function(){
copy(variableText.value,this);
});

document.getElementById("resetVariables").addEventListener("click",function(){
names.forEach(function(name){
values[name]=name;
});
variableText.value=serialize();
render();
});

document.getElementById("copyProcess").addEventListener("click",function(){
parse();
copy(processOutput(),this);
});

render();
})();
</script>
</body>
</html>
