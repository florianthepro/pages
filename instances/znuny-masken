<script>
(function(){
"use strict";
document.querySelectorAll("[data-go]").forEach(function(button){
button.addEventListener("click",function(){window.location.href=button.getAttribute("data-go")});
});
var menuButton=document.getElementById("menuButton");
var menuOverlay=document.getElementById("menuOverlay");
var menuBackdrop=document.getElementById("menuBackdrop");
var menuClose=document.getElementById("menuClose");
function openMenu(){
menuOverlay.classList.add("visible");
menuOverlay.setAttribute("aria-hidden","false");
document.documentElement.style.overflow="hidden";
}
function closeMenu(){
menuOverlay.classList.remove("visible");
menuOverlay.setAttribute("aria-hidden","true");
document.documentElement.style.overflow="";
}
menuButton.addEventListener("click",function(){menuOverlay.classList.contains("visible")?closeMenu():openMenu()});
menuBackdrop.addEventListener("click",closeMenu);
menuClose.addEventListener("click",closeMenu);
document.addEventListener("keydown",function(event){if(event.key==="Escape"){closeMenu()}});
document.querySelectorAll("[data-tab-button]").forEach(function(button){
button.addEventListener("click",function(){
document.querySelectorAll("[data-tab]").forEach(function(section){
section.classList.toggle("hidden",section.getAttribute("data-tab")!==button.getAttribute("data-tab-button"));
});
});
});
function bindStep(step){
var remove=step.querySelector("[data-remove-step]");
var up=step.querySelector("[data-move-up]");
var down=step.querySelector("[data-move-down]");
var name=step.querySelector("[data-step-name]");
var action=step.querySelector("[data-step-action]");
var title=step.querySelector("[data-step-title]");
var kind=step.querySelector("[data-step-kind]");
remove.addEventListener("click",function(){
if(document.querySelectorAll("#steps .editor-step").length<=1){alert("Mindestens ein Prozessschritt ist erforderlich.");return}
step.remove();
});
up.addEventListener("click",function(){var previous=step.previousElementSibling;if(previous){step.parentNode.insertBefore(step,previous)}});
down.addEventListener("click",function(){var next=step.nextElementSibling;if(next){step.parentNode.insertBefore(next,step)}});
name.addEventListener("input",function(){title.textContent=name.value||"Unbenannter Schritt"});
action.addEventListener("change",function(){kind.textContent=action.value==="ticket"?"Ticket":"Notiz"});
}
document.querySelectorAll("#steps .editor-step").forEach(bindStep);
var addStep=document.getElementById("addStep");
var stepTemplate=document.getElementById("stepTemplate");
var steps=document.getElementById("steps");
if(addStep&&stepTemplate&&steps){
addStep.addEventListener("click",function(){
var step=stepTemplate.content.firstElementChild.cloneNode(true);
steps.appendChild(step);
bindStep(step);
step.scrollIntoView({behavior:"smooth",block:"center"});
});
}
var maskNode=document.getElementById("maskData");
if(!maskNode){return}
var mask;
try{mask=JSON.parse(maskNode.textContent)}catch(error){return}
var workflow=document.getElementById("workflow");
var variableList=document.getElementById("variableList");
var values={};
function collectVariables(){
(mask.steps||[]).forEach(function(step){
["subject","body"].forEach(function(field){
String(step[field]||"").replace(/\{\{([^{}]{1,80})\}\}/g,function(match,name){
name=name.trim();
if(name&&!Object.prototype.hasOwnProperty.call(values,name)){values[name]=""}
return match;
});
});
});
}
function renderTemplate(container,text){
container.textContent="";
var source=String(text||"");
var expression=/\{\{([^{}]{1,80})\}\}/g;
var position=0;
var match;
while((match=expression.exec(source))!==null){
if(match.index>position){container.appendChild(document.createTextNode(source.slice(position,match.index)))}
var name=match[1].trim();
var field=document.createElement("span");
field.className="editable-variable";
field.contentEditable="true";
field.spellcheck=false;
field.setAttribute("data-variable",name);
field.setAttribute("role","textbox");
field.setAttribute("aria-label",name);
field.textContent=values[name]||name;
field.addEventListener("focus",function(){
if(!values[name]&&field.textContent===name){
var selection=window.getSelection();
var range=document.createRange();
range.selectNodeContents(field);
selection.removeAllRanges();
selection.addRange(range);
}
});
field.addEventListener("input",function(){
values[name]=field.textContent.replace(/\r/g,"");
synchronizeVariable(name,field);
});
container.appendChild(field);
position=expression.lastIndex;
}
if(position<source.length){container.appendChild(document.createTextNode(source.slice(position)))}
}
function synchronizeVariable(name,source){
document.querySelectorAll("[data-variable]").forEach(function(element){
if(element===source||element.getAttribute("data-variable")!==name){return}
if(element.tagName==="TEXTAREA"){element.value=values[name]}else{element.textContent=values[name]||name}
});
}
function renderVariables(){
variableList.textContent="";
Object.keys(values).forEach(function(name){
var row=document.createElement("div");
row.className="variable-row";
var label=document.createElement("label");
label.textContent=name;
var input=document.createElement("textarea");
input.rows=2;
input.value=values[name];
input.setAttribute("data-variable",name);
input.addEventListener("input",function(){
values[name]=input.value;
synchronizeVariable(name,input);
});
var copy=document.createElement("button");
copy.type="button";
copy.className="secondary small";
copy.textContent="Kopieren";
copy.addEventListener("click",function(){copyText(values[name],copy)});
row.appendChild(label);
row.appendChild(input);
row.appendChild(copy);
variableList.appendChild(row);
});
if(Object.keys(values).length===0){
var empty=document.createElement("div");
empty.className="muted";
empty.textContent="Keine Variablen vorhanden.";
variableList.appendChild(empty);
}
}
function addTicketField(container,label,value){
if(!value){return}
var labelElement=document.createElement("div");
var valueElement=document.createElement("div");
labelElement.className="ticket-label";
valueElement.className="ticket-value";
labelElement.textContent=label;
valueElement.textContent=value;
container.appendChild(labelElement);
container.appendChild(valueElement);
}
function renderWorkflow(){
workflow.textContent="";
(mask.steps||[]).forEach(function(step,index){
if(index>0){
var arrow=document.createElement("div");
arrow.className="process-arrow";
arrow.textContent="↓";
workflow.appendChild(arrow);
}
var ticket=document.createElement("section");
ticket.className="ticket";
var header=document.createElement("div");
header.className="ticket-header";
var number=document.createElement("span");
number.className="ticket-number";
number.textContent=String(index+1);
var title=document.createElement("strong");
title.textContent=step.name||"Prozessschritt";
var kind=document.createElement("span");
kind.className="ticket-kind";
kind.textContent=step.action==="ticket"?"Ticket":"Notiz";
header.appendChild(number);
header.appendChild(title);
header.appendChild(kind);
var fields=document.createElement("div");
fields.className="ticket-fields";
addTicketField(fields,"Tickettyp",step.type);
addTicketField(fields,"Queue",step.queue);
addTicketField(fields,"Service",step.service);
addTicketField(fields,"Status",step.state);
var content=document.createElement("div");
content.className="ticket-content";
if(step.subject){
var subject=document.createElement("div");
subject.className="ticket-subject";
renderTemplate(subject,step.subject);
content.appendChild(subject);
}
var text=document.createElement("div");
text.className="ticket-text";
renderTemplate(text,step.body);
content.appendChild(text);
ticket.appendChild(header);
if(fields.childNodes.length){ticket.appendChild(fields)}
ticket.appendChild(content);
workflow.appendChild(ticket);
});
}
function textWithValues(text){
return String(text||"").replace(/\{\{([^{}]{1,80})\}\}/g,function(match,name){
name=name.trim();
return values[name]||name;
});
}
function processText(){
return (mask.steps||[]).map(function(step,index){
var lines=[];
lines.push((index+1)+". "+String(step.name||"Prozessschritt"));
lines.push("Art: "+(step.action==="ticket"?"Ticket":"Notiz"));
if(step.type){lines.push("Tickettyp: "+step.type)}
if(step.queue){lines.push("Queue: "+step.queue)}
if(step.service){lines.push("Service: "+step.service)}
if(step.state){lines.push("Status: "+step.state)}
if(step.subject){lines.push("Betreff: "+textWithValues(step.subject))}
lines.push("");
lines.push(textWithValues(step.body));
return lines.join("\n").trim();
}).join("\n\n========================================\n\n");
}
function variableText(){
return Object.keys(values).map(function(name){return name+": "+values[name]}).join("\n");
}
function fallbackCopy(text){
var area=document.createElement("textarea");
area.value=text;
area.style.position="fixed";
area.style.left="-9999px";
document.body.appendChild(area);
area.select();
document.execCommand("copy");
area.remove();
}
function copyText(text,button){
function complete(){
var original=button.textContent;
button.textContent="Kopiert";
setTimeout(function(){button.textContent=original},1000);
}
if(navigator.clipboard&&window.isSecureContext){
navigator.clipboard.writeText(text).then(complete).catch(function(){fallbackCopy(text);complete()});
}else{
fallbackCopy(text);
complete();
}
}
document.getElementById("copyVariables").addEventListener("click",function(){
copyText(variableText(),this);
});
document.getElementById("clearVariables").addEventListener("click",function(){
Object.keys(values).forEach(function(name){values[name]=""});
renderVariables();
renderWorkflow();
});
document.getElementById("applyVariables").addEventListener("click",function(){
var text=document.getElementById("variableImport").value;
text.split(/\r?\n/).forEach(function(line){
var separator=line.indexOf(":");
if(separator<1){return}
var name=line.slice(0,separator).trim();
var value=line.slice(separator+1).trim();
if(Object.prototype.hasOwnProperty.call(values,name)){values[name]=value}
});
renderVariables();
renderWorkflow();
});
document.getElementById("copyProcess").addEventListener("click",function(){
copyText(processText(),this);
});
collectVariables();
renderVariables();
renderWorkflow();
})();
</script>
</body>
</html>
