header('Referrer-Policy: same-origin');

function html($value):string{
return htmlspecialchars((string)$value,ENT_QUOTES|ENT_SUBSTITUTE,'UTF-8');
}

function text($value,int $limit=30000):string{
if(!is_string($value)){
return '';
}
$value=trim(str_replace(chr(0),'',$value));
if(function_exists('mb_substr')){
return mb_substr($value,0,$limit,'UTF-8');
}
return substr($value,0,$limit);
}

function identifier():string{
try{
return bin2hex(random_bytes(12));
}catch(Throwable $exception){
return str_replace('.','',uniqid('',true));
}
}

function emptyData():array{
return ['masks'=>[]];
}

function initializeStorage():void{
if(is_file(DATA_FILE)){
return;
}
$json=json_encode(
emptyData(),
JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES
);
if($json===false||file_put_contents(DATA_FILE,$json,LOCK_EX)===false){
http_response_code(500);
exit('masks.json konnte nicht angelegt werden.');
}
@chmod(DATA_FILE,0660);
}

function loadData():array{
initializeStorage();

$handle=@fopen(DATA_FILE,'rb');
if($handle===false){
http_response_code(500);
exit('masks.json konnte nicht geöffnet werden.');
}

if(!flock($handle,LOCK_SH)){
fclose($handle);
http_response_code(500);
exit('masks.json konnte nicht gesperrt werden.');
}

$json=stream_get_contents($handle);
flock($handle,LOCK_UN);
fclose($handle);

$data=json_decode((string)$json,true);
if(json_last_error()!==JSON_ERROR_NONE||!is_array($data)){
http_response_code(500);
exit('masks.json enthält ungültiges JSON.');
}

if(!isset($data['masks'])||!is_array($data['masks'])){
$data['masks']=[];
}

return $data;
}

function saveData(array $data):void{
$json=json_encode(
$data,
JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES
);
if($json===false){
throw new RuntimeException('JSON konnte nicht erzeugt werden.');
}

$handle=@fopen(DATA_FILE,'c+b');
if($handle===false){
throw new RuntimeException('masks.json ist nicht beschreibbar.');
}

if(!flock($handle,LOCK_EX)){
fclose($handle);
throw new RuntimeException('masks.json konnte nicht gesperrt werden.');
}

$success=ftruncate($handle,0);
if($success){
$success=rewind($handle);
}
if($success){
$length=strlen($json);
$written=0;
while($written<$length){
$result=fwrite($handle,substr($json,$written));
if($result===false||$result===0){
$success=false;
break;
}
$written+=$result;
}
}
if($success){
$success=fflush($handle);
}

flock($handle,LOCK_UN);
fclose($handle);

if(!$success){
throw new RuntimeException('masks.json konnte nicht gespeichert werden.');
}
}

function csrfToken():string{
if(empty($_SESSION['csrf'])||!is_string($_SESSION['csrf'])){
try{
$_SESSION['csrf']=bin2hex(random_bytes(32));
}catch(Throwable $exception){
$_SESSION['csrf']=hash('sha256',uniqid('',true));
}
}
return $_SESSION['csrf'];
}

function verifyCsrf():void{
$token=isset($_POST['csrf'])&&is_string($_POST['csrf'])
?$_POST['csrf']
:'';
if(!hash_equals(csrfToken(),$token)){
http_response_code(403);
exit('Ungültige Anfrage.');
}
}

function postArray(string $name):array{
if(isset($_POST[$name])&&is_array($_POST[$name])){
return $_POST[$name];
}
return [];
}

function findMask(array $data,string $id):?array{
foreach($data['masks'] as $mask){
if(is_array($mask)&&(string)($mask['id']??'')===$id){
return $mask;
}
}
return null;
}

function normalizeMask(array $mask):array{
if(!isset($mask['fields'])||!is_array($mask['fields'])){
$mask['fields']=[];
}
if(!isset($mask['steps'])||!is_array($mask['steps'])){
$mask['steps']=[];
}
return $mask;
}

function maskFromPost():array{
$name=text($_POST['name']??'',120);
if($name===''){
throw new RuntimeException('Der Maskenname fehlt.');
}

$fieldIds=postArray('field_id');
$fieldLabels=postArray('field_label');
$fieldValues=postArray('field_value');
$fields=[];
$fieldCount=max(count($fieldLabels),count($fieldValues));

for($index=0;$index<$fieldCount;$index++){
$label=text($fieldLabels[$index]??'',120);
$value=text($fieldValues[$index]??'',3000);

if($label===''&&$value===''){
continue;
}
if($label===''){
throw new RuntimeException('Jedes gemeinsame Feld benötigt eine Bezeichnung.');
}

$fieldId=text($fieldIds[$index]??'',64);
if($fieldId===''){
$fieldId=identifier();
}

$fields[]=[
'id'=>$fieldId,
'label'=>$label,
'value'=>$value
];
}

$stepIds=postArray('step_id');
$stepNames=postArray('step_name');
$stepOperations=postArray('step_operation');
$stepSubjects=postArray('step_subject');
$stepBodies=postArray('step_body');

$stepCount=max(
count($stepNames),
count($stepOperations),
count($stepSubjects),
count($stepBodies)
);

if($stepCount<1){
throw new RuntimeException('Mindestens ein Prozessschritt ist erforderlich.');
}
if($stepCount>100){
throw new RuntimeException('Maximal 100 Prozessschritte sind erlaubt.');
}

$steps=[];

for($index=0;$index<$stepCount;$index++){
$stepName=text($stepNames[$index]??'',120);
if($stepName===''){
throw new RuntimeException('Jeder Prozessschritt benötigt eine Bezeichnung.');
}

$stepId=text($stepIds[$index]??'',64);
if($stepId===''){
$stepId=identifier();
}

$steps[]=[
'id'=>$stepId,
'name'=>$stepName,
'operation'=>text($stepOperations[$index]??'',120),
'subject'=>text($stepSubjects[$index]??'',1000),
'body'=>text($stepBodies[$index]??'',30000)
];
}

$maskId=text($_POST['mask_id']??'',64);
if($maskId===''){
$maskId=identifier();
}

return [
'id'=>$maskId,
'name'=>$name,
'description'=>text($_POST['description']??'',3000),
'published'=>isset($_POST['published']),
'fields'=>$fields,
'steps'=>$steps,
'updatedAt'=>gmdate('c')
];
}

if(
($_SERVER['REQUEST_METHOD']??'GET')==='POST'&&
(int)($_SERVER['CONTENT_LENGTH']??0)>MAX_POST_SIZE
){
http_response_code(413);
exit('Die Anfrage ist zu groß.');
}

$data=loadData();
$page=text($_GET['_page']??'',30);
$editId=text($_GET['_edit']??'',64);
$maskId=text($_GET['_mask']??'',64);
$message='';
$error='';

if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'){
try{
verifyCsrf();
$action=text($_POST['action']??'',30);

if($action==='save_mask'){
$mask=maskFromPost();
$updated=false;

foreach($data['masks'] as $index=>$storedMask){
if(
is_array($storedMask)&&
(string)($storedMask['id']??'')===$mask['id']
){
$data['masks'][$index]=$mask;
$updated=true;
break;
}
}

if(!$updated){
$data['masks'][]=$mask;
}

saveData($data);
header('Location: ?_page=edit&_result=saved');
exit;
}

if($action==='delete_mask'){
$deleteId=text($_POST['mask_id']??'',64);
$newMasks=[];

foreach($data['masks'] as $storedMask){
if(
is_array($storedMask)&&
(string)($storedMask['id']??'')===$deleteId
){
continue;
}
$newMasks[]=$storedMask;
}

$data['masks']=$newMasks;
saveData($data);
header('Location: ?_page=edit&_result=deleted');
exit;
}

throw new RuntimeException('Unbekannte Aktion.');
}catch(Throwable $exception){
$error=$exception->getMessage();
}
}

if(($_GET['_result']??'')==='saved'){
$message='Maske gespeichert.';
}
if(($_GET['_result']??'')==='deleted'){
$message='Maske gelöscht.';
}

$editedMask=null;
if($editId!==''&&$editId!=='new'){
$editedMask=findMask($data,$editId);
if($editedMask!==null){
$editedMask=normalizeMask($editedMask);
}
}

$selectedMask=null;
if($maskId!==''){
$selectedMask=findMask($data,$maskId);
if($selectedMask!==null){
$selectedMask=normalizeMask($selectedMask);
}
}
