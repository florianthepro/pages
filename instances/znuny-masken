ini_set('log_errors','1');
error_reporting(E_ALL);
const DATA_FILE=__DIR__.'/masks.json';
const MAX_POST_SIZE=2097152;
session_name('znuny_masks');
session_set_cookie_params(['lifetime'=>0,'path'=>'/','secure'=>isset($_SERVER['HTTPS'])&&$_SERVER['HTTPS']!=='off','httponly'=>true,'samesite'=>'Strict']);
session_start();
header('X-Content-Type-Options: nosniff');
header('X-Frame-Options: SAMEORIGIN');
header('Referrer-Policy: same-origin');
function h($value):string{
return htmlspecialchars((string)$value,ENT_QUOTES|ENT_SUBSTITUTE,'UTF-8');
}
function valueText($value,int $limit=20000):string{
if(!is_string($value)){return '';}
$value=trim(str_replace("\0",'',$value));
return function_exists('mb_substr')?mb_substr($value,0,$limit,'UTF-8'):substr($value,0,$limit);
}
function createId():string{
try{return bin2hex(random_bytes(12));}
catch(Throwable $exception){return str_replace('.','',uniqid('',true));}
}
function initialData():array{
return ['settings'=>['ticketTypes'=>[],'queues'=>[],'services'=>[],'states'=>[]],'masks'=>[]];
}
function initializeData():void{
if(is_file(DATA_FILE)){return;}
$json=json_encode(initialData(),JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);
if($json===false||file_put_contents(DATA_FILE,$json,LOCK_EX)===false){
http_response_code(500);
exit('masks.json konnte nicht angelegt werden.');
}
@chmod(DATA_FILE,0660);
}
function loadData():array{
initializeData();
$handle=@fopen(DATA_FILE,'rb');
if($handle===false){http_response_code(500);exit('masks.json konnte nicht geöffnet werden.');}
if(!flock($handle,LOCK_SH)){fclose($handle);http_response_code(500);exit('masks.json konnte nicht gesperrt werden.');}
$json=stream_get_contents($handle);
flock($handle,LOCK_UN);
fclose($handle);
$data=json_decode((string)$json,true);
if(json_last_error()!==JSON_ERROR_NONE||!is_array($data)){http_response_code(500);exit('masks.json enthält ungültiges JSON.');}
if(!isset($data['settings'])||!is_array($data['settings'])){$data['settings']=[];}
foreach(['ticketTypes','queues','services','states'] as $key){
if(!isset($data['settings'][$key])||!is_array($data['settings'][$key])){$data['settings'][$key]=[];}
}
if(!isset($data['masks'])||!is_array($data['masks'])){$data['masks']=[];}
return $data;
}
function saveData(array $data):void{
$json=json_encode($data,JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);
if($json===false){throw new RuntimeException('JSON konnte nicht erzeugt werden.');}
$temp=DATA_FILE.'.tmp.'.createId();
$handle=@fopen($temp,'xb');
if($handle===false){throw new RuntimeException('Temporäre Datei konnte nicht erstellt werden.');}
if(!flock($handle,LOCK_EX)){fclose($handle);@unlink($temp);throw new RuntimeException('Datei konnte nicht gesperrt werden.');}
$length=strlen($json);
$written=0;
$success=true;
while($written<$length){
$result=fwrite($handle,substr($json,$written));
if($result===false||$result===0){$success=false;break;}
$written+=$result;
}
$success=$success&&fflush($handle);
flock($handle,LOCK_UN);
fclose($handle);
if(!$success){@unlink($temp);throw new RuntimeException('masks.json konnte nicht geschrieben werden.');}
@chmod($temp,0660);
if(!@rename($temp,DATA_FILE)){@unlink($temp);throw new RuntimeException('masks.json konnte nicht ersetzt werden.');}
}
function csrfToken():string{
if(!isset($_SESSION['csrf'])||!is_string($_SESSION['csrf'])){
try{$_SESSION['csrf']=bin2hex(random_bytes(32));}
catch(Throwable $exception){$_SESSION['csrf']=hash('sha256',uniqid('',true));}
}
return $_SESSION['csrf'];
}
function verifyCsrf():void{
$token=isset($_POST['csrf'])&&is_string($_POST['csrf'])?$_POST['csrf']:'';
if(!hash_equals(csrfToken(),$token)){http_response_code(403);exit('Ungültige Anfrage.');}
}
function textList($value):array{
if(!is_string($value)){return [];}
$lines=preg_split('/\R/u',$value);
$result=[];
foreach(is_array($lines)?$lines:[] as $line){
$item=valueText($line,120);
if($item!==''&&!in_array($item,$result,true)){$result[]=$item;}
}
return $result;
}
function postArray(string $name):array{
return isset($_POST[$name])&&is_array($_POST[$name])?$_POST[$name]:[];
}
function findMask(array $data,string $id):?array{
foreach($data['masks'] as $mask){
if(is_array($mask)&&(string)($mask['id']??'')===$id){return $mask;}
}
return null;
}
function maskFromPost():array{
$name=valueText($_POST['name']??'',120);
if($name===''){throw new RuntimeException('Der Maskenname fehlt.');}
$ids=postArray('step_id');
$names=postArray('step_name');
$actions=postArray('step_action');
$types=postArray('step_type');
$queues=postArray('step_queue');
$services=postArray('step_service');
$states=postArray('step_state');
$subjects=postArray('step_subject');
$bodies=postArray('step_body');
$count=count($actions);
if($count<1){throw new RuntimeException('Mindestens ein Prozessschritt ist erforderlich.');}
if($count>100){throw new RuntimeException('Maximal 100 Prozessschritte sind erlaubt.');}
$steps=[];
for($index=0;$index<$count;$index++){
$action=valueText($actions[$index]??'',20);
if(!in_array($action,['ticket','note'],true)){$action='note';}
$stepName=valueText($names[$index]??'',120);
if($stepName===''){throw new RuntimeException('Jeder Prozessschritt benötigt einen Namen.');}
$stepId=valueText($ids[$index]??'',64);
$steps[]=[
'id'=>$stepId!==''?$stepId:createId(),
'action'=>$action,
'name'=>$stepName,
'type'=>valueText($types[$index]??'',120),
'queue'=>valueText($queues[$index]??'',120),
'service'=>valueText($services[$index]??'',120),
'state'=>valueText($states[$index]??'',120),
'subject'=>valueText($subjects[$index]??'',500),
'body'=>valueText($bodies[$index]??'',20000)
];
}
$id=valueText($_POST['mask_id']??'',64);
return ['id'=>$id!==''?$id:createId(),'name'=>$name,'description'=>valueText($_POST['description']??'',2000),'published'=>isset($_POST['published']),'updatedAt'=>gmdate('c'),'steps'=>$steps];
}
function selectOptions(array $values,string $selected):void{
echo '<option value="">Keine Auswahl</option>';
foreach($values as $value){
$value=(string)$value;
echo '<option value="'.h($value).'"'.($value===$selected?' selected':'').'>'.h($value).'</option>';
}
}
if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'&&(int)($_SERVER['CONTENT_LENGTH']??0)>MAX_POST_SIZE){
http_response_code(413);
exit('Die Anfrage ist zu groß.');
}
$data=loadData();
$page=valueText($_GET['_page']??'',30);
$editId=valueText($_GET['_edit']??'',64);
$maskId=valueText($_GET['_mask']??'',64);
$tab=($_GET['_tab']??'')==='settings'?'settings':'masks';
$message='';
$error='';
if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'){
try{
verifyCsrf();
$action=valueText($_POST['action']??'',30);
if($action==='save_settings'){
$data['settings']=[
'ticketTypes'=>textList($_POST['ticketTypes']??''),
'queues'=>textList($_POST['queues']??''),
'services'=>textList($_POST['services']??''),
'states'=>textList($_POST['states']??'')
];
saveData($data);
header('Location: ?_page=edit&_tab=settings&_result=settings');
exit;
}
if($action==='save_mask'){
$mask=maskFromPost();
$updated=false;
foreach($data['masks'] as $index=>$stored){
if(is_array($stored)&&(string)($stored['id']??'')===$mask['id']){
$data['masks'][$index]=$mask;
$updated=true;
break;
}
}
if(!$updated){$data['masks'][]=$mask;}
saveData($data);
header('Location: ?_page=edit&_edit='.rawurlencode($mask['id']).'&_result=mask');
exit;
}
if($action==='delete_mask'){
$id=valueText($_POST['mask_id']??'',64);
$data['masks']=array_values(array_filter($data['masks'],static function($mask)use($id){
return !is_array($mask)||(string)($mask['id']??'')!==$id;
}));
saveData($data);
header('Location: ?_page=edit&_result=deleted');
exit;
}
throw new RuntimeException('Unbekannte Aktion.');
}catch(Throwable $exception){
$error=$exception->getMessage();
}
}
if(($_GET['_result']??'')==='settings'){$message='Feste Werte gespeichert.';}
if(($_GET['_result']??'')==='mask'){$message='Maske gespeichert.';}
if(($_GET['_result']??'')==='deleted'){$message='Maske gelöscht.';}
$editedMask=$editId!==''&&$editId!=='new'?findMask($data,$editId):null;
$selectedMask=$maskId!==''?findMask($data,$maskId):null;
?>
