<script>
(function(){
"use strict";
var menuButton=document.querySelector("[data-menu-button]");
var menuOverlay=document.querySelector("[data-menu-overlay]");
document.querySelectorAll("[data-menu-close]").forEach(function(element){element.addEventListener("click",closeMenu)});
function openMenu(){menuOverlay.classList.add("is-visible");menuOverlay.setAttribute("aria-hidden","false");document.documentElement.style.overflow="hidden"}
function closeMenu(){menuOverlay.classList.remove("is-visible");menuOverlay.setAttribute("aria-hidden","true");document.documentElement.style.overflow=""}
if(menuButton){menuButton.addEventListener("click",function(){menuOverlay.classList.contains("is-visible")?closeMenu():openMenu()})}
document.addEventListener("keydown",function(event){if(event.key==="Escape"){closeMenu()}});
document.querySelectorAll("[data-tab-button]").forEach(function(button){
button.addEventListener("click",function(){
document.querySelectorAll("[data-tab]").forEach(function(section){section.classList.toggle("hidden",section.dataset.tab!==button.dataset.tabButton)});
});
});
function bindStep(step){
var remove=step.querySelector("[data-remove-step]");
var name=step.querySelector("[data-step-name]");
var action=step.querySelector("[data-step-action]");
var title=step.querySelector("[data-step-title]");
var kind=step.querySelector("[data-step-kind]");
if(remove){remove.addEventListener("click",function(){if(document.querySelectorAll("#steps .step").length<=1){alert("Mindestens ein Schritt ist erforderlich.");return}step.remove()})}
if(name&&title){name.addEventListener("input",function(){title.textContent=name.value||"Unbenannter Schritt"})}
if(action&&kind){action.addEventListener("change",function(){kind.textContent=action.value==="ticket"?"Neues Ticket":"Notiz"})}
}
document.querySelectorAll("#steps .step").forEach(bindStep);
var addStep=document.getElementById("addStep");
var template=document.getElementById("stepTemplate");
var steps=document.getElementById("steps");
if(addStep&&template&&steps){addStep.addEventListener("click",function(){var step=template.content.firstElementChild.cloneNode(true);steps.appendChild(step);bindStep(step);step.scrollIntoView({behavior:"smooth",block:"center"})})}
var dataNode=document.getElementById("maskData");
if(!dataNode){return}
var mask=JSON.parse(dataNode.textContent);
var preview=document.getElementById("preview");
var inputs=Array.from(document.querySelectorAll("[data-placeholder]"));
function inputValues(){var result={};inputs.forEach(function(input){result[input.dataset.placeholder]=input.value});return result}
function renderText(text,values){return String(text||"").replace(/\{\{([^{}]{1,80})\}\}/gu,function(match,name){return values[name.trim()]||""})}
function stepOutput(step,index,values){
var lines=[(index+1)+". "+(step.name||"Schritt"),"Aktion: "+(step.action==="ticket"?"Neues Ticket":"Notiz")];
if(step.type){lines.push("Tickettyp: "+step.type)}
if(step.queue){lines.push("Queue: "+step.queue)}
if(step.service){lines.push("Service: "+step.service)}
if(step.state){lines.push("Status: "+step.state)}
if(step.subject){lines.push("Betreff: "+renderText(step.subject,values))}
lines.push("",renderText(step.body,values));
return lines.join("\n").trim()
}
function copy(value,button){
function done(){var original=button.textContent;button.textContent="Kopiert";setTimeout(function(){button.textContent=original},1200)}
if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(value).then(done).catch(function(){legacyCopy(value);done()})}else{legacyCopy(value);done()}
}
function legacyCopy(value){var area=document.createElement("textarea");area.value=value;area.style.position="fixed";area.style.left="-9999px";document.body.appendChild(area);area.select();document.execCommand("copy");area.remove()}
function meta(list,label,value){if(!value){return}var dt=document.createElement("dt");var dd=document.createElement("dd");dt.textContent=label;dd.textContent=value;list.append(dt,dd)}
function render(){
var values=inputValues();preview.textContent="";
(mask.steps||[]).forEach(function(step,index){
var section=document.createElement("section");section.className="preview-step";
var header=document.createElement("div");header.className="preview-head";
var title=document.createElement("strong");title.textContent=(index+1)+". "+(step.name||"Schritt");
var kind=document.createElement("span");kind.className="muted";kind.textContent=step.action==="ticket"?"Neues Ticket":"Notiz";
var button=document.createElement("button");button.type="button";button.className="secondary small";button.textContent="Schritt kopieren";button.addEventListener("click",function(){copy(stepOutput(step,index,inputValues()),button)});
header.append(title,kind,button);
var body=document.createElement("div");body.className="preview-body";
var list=document.createElement("dl");list.className="preview-meta";
meta(list,"Tickettyp",step.type);meta(list,"Queue",step.queue);meta(list,"Service",step.service);meta(list,"Status",step.state);
body.appendChild(list);
var subject=renderText(step.subject,values);
if(subject){var subjectBox=document.createElement("div");subjectBox.className="preview-subject";subjectBox.textContent=subject;body.appendChild(subjectBox)}
var text=document.createElement("div");text.className="preview-text";text.textContent=renderText(step.body,values);body.appendChild(text);
section.append(header,body);preview.appendChild(section)
});
}
inputs.forEach(function(input){input.addEventListener("input",render)});
var copyAll=document.getElementById("copyAll");
if(copyAll){copyAll.addEventListener("click",function(){var values=inputValues();copy((mask.steps||[]).map(function(step,index){return stepOutput(step,index,values)}).join("\n\n========================================\n\n"),copyAll)})}
var clear=document.getElementById("clearFields");
if(clear){clear.addEventListener("click",function(){inputs.forEach(function(input){input.value=""});render()})}
render();
})();
</script>
</body>
</html>
