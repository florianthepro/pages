];
saveData($data);
header('Location: ?_page=edit&_saved=settings');
exit;
}
if($action==='save_mask'){
$mask=maskFromPost();
$found=false;
foreach($data['masks'] as $index=>$stored){
if(is_array($stored)&&(string)($stored['id']??'')===$mask['id']){
$data['masks'][$index]=$mask;
$found=true;
break;
}
}
if(!$found){$data['masks'][]=$mask;}
saveData($data);
header('Location: ?_page=edit&_edit='.rawurlencode($mask['id']).'&_saved=mask');
exit;
}
if($action==='delete_mask'){
$id=cut($_POST['mask_id']??'',64);
$data['masks']=array_values(array_filter($data['masks'],static function($mask)use($id){
return !is_array($mask)||(string)($mask['id']??'')!==$id;
}));
saveData($data);
header('Location: ?_page=edit&_deleted=1');
exit;
}
throw new RuntimeException('Unbekannte Aktion.');
}catch(Throwable $exception){
$error=$exception->getMessage();
}
}
if(($_GET['_saved']??'')==='settings'){$message='Feste Werte gespeichert.';}
if(($_GET['_saved']??'')==='mask'){$message='Maske gespeichert.';}
if(isset($_GET['_deleted'])){$message='Maske gelöscht.';}
