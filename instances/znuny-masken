const DATA_FILE=__DIR__.'/masks.json';
const MAX_POST_SIZE=2097152;

session_name('znuny_masks');
session_set_cookie_params([
'lifetime'=>0,
'path'=>'/',
'secure'=>!empty($_SERVER['HTTPS'])&&$_SERVER['HTTPS']!=='off',
'httponly'=>true,
